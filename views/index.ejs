<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= s.seo_title %></title>
<meta name="description" content="<%= s.seo_description %>">
<meta name="keywords" content="<%= s.seo_keywords %>">
<link rel="canonical" href="<%= siteUrl %>/">
<meta name="theme-color" content="#0b0d0e">

<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= s.site_name %>">
<meta property="og:title" content="<%= s.seo_title %>">
<meta property="og:description" content="<%= s.seo_description %>">
<meta property="og:image" content="<%= s.hero_image.startsWith('http') ? s.hero_image : siteUrl + s.hero_image %>">
<meta property="og:url" content="<%= siteUrl %>/">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230b0d0e'/%3E%3Ctext x='50%25' y='57%25' dominant-baseline='middle' text-anchor='middle' font-family='Arial,sans-serif' font-weight='700' font-size='38' fill='%231fd1c1'%3E<%= s.brand_name.charAt(0).toUpperCase() %>%3C/text%3E%3C/svg%3E">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org", "@type": "ProfessionalService",
  name: s.site_name, description: s.seo_description, url: siteUrl + '/',
  image: s.hero_image.startsWith('http') ? s.hero_image : siteUrl + s.hero_image,
  telephone: s.phone, email: s.email,
  address: { "@type": "PostalAddress", addressLocality: s.location_short, addressCountry: "NG" },
  areaServed: s.location_short, priceRange: "₦₦₦",
  sameAs: socials.map(x => x.url)
}, null, 1) %>
</script>
</head>

<body>
<a class="skip" href="#main">Skip to content</a>
<div class="curtain" id="curtain" aria-hidden="true"><strong><%= s.brand_name %></strong></div>

<%- include('_sprite') %>

<% const wm = s.brand_name.toUpperCase().replace(/[^A-Z]/g,'') || 'A'; const L = i => wm[i % wm.length]; %>

<!-- ================= NAVIGATION ================= -->
<header class="nav" id="nav">
  <div class="container">
    <a class="brand" href="#hero" aria-label="<%= s.site_name %> — home"><strong><%= s.brand_name %></strong><small><%= s.brand_tagline %></small></a>
    <button class="burger" id="burger" aria-expanded="false" aria-controls="navLinks" aria-label="Open menu"><span></span><span></span><span></span></button>
    <nav class="nav-links" id="navLinks" aria-label="Primary">
      <a href="#hero" data-nav="hero">Home</a>
      <a href="#about" data-nav="about">About</a>
      <a href="#portfolio" data-nav="portfolio">Portfolio</a>
      <a href="#services" data-nav="services">Services</a>
      <a href="#contact" data-nav="contact">Contact</a>
      <a href="#contact" class="btn btn-primary">Book a session</a>
    </nav>
  </div>
</header>

<main id="main">

<!-- ================= HERO ================= -->
<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="wm" aria-hidden="true"><%= L(0) %></div>
  <div class="container">
    <div class="hero-copy">
      <p class="eyebrow" data-intro style="--i:0"><%= s.hero_eyebrow %></p>
      <h1 class="display" id="hero-title" data-intro style="--i:1"><%- accent(s.hero_title) %></h1>
      <div class="rule" data-intro style="--i:2"></div>
      <p class="lead" data-intro style="--i:3"><%= s.hero_intro %></p>
      <div class="hero-actions" data-intro style="--i:4">
        <a href="#portfolio" class="btn btn-primary">View portfolio <svg><use href="#i-arrow"/></svg></a>
        <a href="#contact" class="btn btn-ghost">Book a session</a>
      </div>
      <% if (socials.length) { %>
      <div class="hero-social" data-intro style="--i:5">
        <span>Follow</span>
        <div class="social" aria-label="Social media">
          <% socials.slice(0,3).forEach(x => { %><a href="<%= x.url %>" target="_blank" rel="noopener" aria-label="<%= x.key %>"><svg><use href="#i-<%= x.key %>"/></svg></a><% }) %>
        </div>
      </div>
      <% } %>
    </div>
    <div class="hero-media" data-intro style="--i:2" id="heroMedia">
      <div class="hero-frame">
        <img src="<%= s.hero_image %>" width="900" height="1125" fetchpriority="high" decoding="async" alt="<%= s.hero_image_alt %>">
        <div class="hero-tag"><%= s.hero_tag %><span><%= s.hero_tag_sub %></span></div>
      </div>
    </div>
  </div>
</section>

<!-- ================= ABOUT ================= -->
<section id="about" aria-labelledby="about-title">
  <div class="wm right" aria-hidden="true"><%= L(1) %></div>
  <div class="container">
    <div class="about-grid">
      <div class="about-media reveal-img">
        <div class="about-frame">
          <img src="<%= s.about_image %>" width="800" height="1000" loading="lazy" decoding="async" alt="<%= s.about_image_alt %>">
          <% if (s.about_quote) { %><p class="about-quote"><%= s.about_quote %></p><% } %>
        </div>
      </div>
      <div class="about-copy">
        <p class="eyebrow reveal">About</p>
        <h2 class="display reveal" id="about-title" style="--d:.05s"><%- accent(s.about_title) %></h2>
        <div class="rule reveal" style="--d:.1s"></div>
        <div class="reveal" style="--d:.15s">
          <% paragraphs(s.about_bio).forEach(p => { %><p class="lead"><%= p %></p><% }) %>
        </div>
        <% if (aboutPoints.length) { %>
        <div class="about-points">
          <% aboutPoints.forEach(p => { %>
          <div class="point"><svg><use href="#i-<%= p.icon %>"/></svg><div><h3><%= p.title %></h3><p><%= p.text %></p></div></div>
          <% }) %>
        </div>
        <% } %>
        <div class="about-cta">
          <a href="#contact" class="btn btn-primary">Book a session <svg><use href="#i-arrow"/></svg></a>
          <a href="#contact" class="btn btn-ghost">Contact me</a>
        </div>
      </div>
    </div>
    <% if (stats.length) { %>
    <div class="stats" id="stats">
      <% stats.forEach(st => { %>
      <div class="stat"><svg><use href="#i-<%= st.icon %>"/></svg><div class="label"><%= st.label %></div><div class="num" data-count="<%= st.value %>" data-suffix="<%= st.suffix %>">0</div></div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<!-- ================= PORTFOLIO ================= -->
<section id="portfolio" aria-labelledby="portfolio-title">
  <div class="wm left" aria-hidden="true"><%= L(2) %></div>
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h2 class="display" id="portfolio-title"><%- accent(s.portfolio_title) %></h2>
      </div>
      <p class="lead"><%= s.portfolio_intro %></p>
    </div>
    <% const usedCats = new Set(gallery.map(g => g.category)); %>
    <div class="filters" id="filters" role="group" aria-label="Filter portfolio by category">
      <button class="filter" data-filter="all" aria-pressed="true">All</button>
      <% categories.filter(c => usedCats.has(c.slug)).forEach(c => { %>
      <button class="filter" data-filter="<%= c.slug %>" aria-pressed="false"><%= c.label %></button>
      <% }) %>
    </div>
    <div class="masonry" id="gallery" aria-live="polite">
      <% gallery.forEach((g, i) => { %>
      <button class="tile" type="button" data-id="<%= g.id %>" data-cat="<%= g.category %>" style="animation-delay:<%= Math.min(i,12)*40 %>ms" aria-label="Open <%= g.title %> in full-screen viewer">
        <img src="<%= g.src_thumb %>" width="<%= g.width %>" height="<%= g.height %>" loading="lazy" decoding="async" alt="<%= g.alt %>">
        <div class="tile-cap"><span><%= catLabel[g.category] %></span><%= g.title %></div>
      </button>
      <% }) %>
    </div>
    <p class="portfolio-more" id="galleryCount"></p>
  </div>
</section>

<!-- ================= SERVICES ================= -->
<section id="services" aria-labelledby="services-title">
  <div class="wm right" aria-hidden="true"><%= L(3) %></div>
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Services</p>
        <h2 class="display" id="services-title"><%- accent(s.services_title) %></h2>
      </div>
      <p class="lead"><%= s.services_intro %></p>
    </div>
    <div class="services-grid">
      <% services.forEach(sv => { %>
      <article class="svc">
        <svg class="icon"><use href="#i-<%= sv.icon %>"/></svg>
        <h3><%= sv.name %></h3>
        <% if (sv.price) { %><p class="price"><%= sv.price %></p><% } %>
        <p><%= sv.description %></p>
        <% if (sv.includes.length) { %><ul><% sv.includes.forEach(x => { %><li><%= x %></li><% }) %></ul><% } %>
        <a href="#contact" class="btn btn-link" data-service="<%= sv.name %>"><%= sv.cta %> <svg><use href="#i-arrow"/></svg></a>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- ================= TESTIMONIAL ================= -->
<% if (s.testimonial_text) { %>
<section class="testimonial" aria-label="Client testimonial">
  <div class="container">
    <blockquote class="reveal">
      <%= s.testimonial_text %>
      <cite><b><%= s.testimonial_name %></b><% if (s.testimonial_meta) { %> — <%= s.testimonial_meta %><% } %></cite>
    </blockquote>
  </div>
</section>
<% } %>

<!-- ================= CONTACT ================= -->
<section id="contact" aria-labelledby="contact-title">
  <div class="wm left" aria-hidden="true"><%= L(4) %></div>
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="display" id="contact-title"><%- accent(s.contact_title) %></h2>
      </div>
      <p class="lead"><%= s.contact_intro %></p>
    </div>
    <div class="contact-grid">
      <div class="contact-info">
        <ul>
          <li><svg><use href="#i-mail"/></svg><div><h3>Email</h3><a href="mailto:<%= s.email %>"><%= s.email %></a></div></li>
          <li><svg><use href="#i-phone"/></svg><div><h3>Phone / WhatsApp</h3><a href="tel:<%= s.phone.replace(/[^+\d]/g,'') %>"><%= s.phone %></a></div></li>
          <li><svg><use href="#i-pin"/></svg><div><h3>Based in</h3><span><%= s.location %></span></div></li>
          <% if (s.hours) { %><li><svg><use href="#i-clock"/></svg><div><h3>Studio hours</h3><span><%= s.hours %></span></div></li><% } %>
        </ul>
        <% if (socials.length) { %>
        <div class="social" aria-label="Social media">
          <% socials.forEach(x => { %><a href="<%= x.url %>" target="_blank" rel="noopener" aria-label="<%= x.key %>"><svg><use href="#i-<%= x.key %>"/></svg></a><% }) %>
        </div>
        <% } %>
      </div>

      <form class="form" id="enquiryForm" novalidate>
        <div class="form-row">
          <div class="field"><label for="f-name">Name</label><input id="f-name" name="name" type="text" autocomplete="name" placeholder="Your full name" required><span class="error" id="e-name" aria-live="polite"></span></div>
          <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required><span class="error" id="e-email" aria-live="polite"></span></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="f-phone">Phone <small>optional</small></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="+234 ..."><span class="error" id="e-phone" aria-live="polite"></span></div>
          <div class="field"><label for="f-service">Type of photography</label>
            <select id="f-service" name="service" required>
              <option value="">Choose a service</option>
              <% services.forEach(sv => { %><option><%= sv.name %></option><% }) %>
              <option>Something else</option>
            </select><span class="error" id="e-service" aria-live="polite"></span></div>
        </div>
        <div class="field"><label for="f-date">Preferred date <small>optional</small></label><input id="f-date" name="date" type="date"><span class="error" id="e-date" aria-live="polite"></span></div>
        <div class="field"><label for="f-message">Project details</label><textarea id="f-message" name="message" placeholder="Where, when, how many people, and what you're hoping the images will feel like." required></textarea><span class="error" id="e-message" aria-live="polite"></span></div>
        <input type="text" name="company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
        <div class="form-foot">
          <button type="submit" class="btn btn-primary" id="submitBtn">Send enquiry <svg><use href="#i-arrow"/></svg></button>
          <small>No deposit needed to enquire.</small>
        </div>
        <div class="form-status" id="formStatus" role="status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>
</main>

<!-- ================= FOOTER ================= -->
<footer class="footer">
  <div class="wm" aria-hidden="true" style="top:auto;bottom:-30%;font-size:clamp(10rem,30vw,22rem)"><%= L(5) %></div>
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="#hero"><strong><%= s.brand_name %></strong><small><%= s.brand_tagline %></small></a>
        <p><%= s.footer_blurb %></p>
      </div>
      <div class="foot"><h4>Navigate</h4><ul>
        <li><a href="#hero">Home</a></li><li><a href="#about">About</a></li><li><a href="#portfolio">Portfolio</a></li><li><a href="#services">Services</a></li><li><a href="#contact">Contact</a></li>
      </ul></div>
      <div class="foot"><h4>Contact</h4><ul>
        <li><a href="mailto:<%= s.email %>"><%= s.email %></a></li><li><a href="tel:<%= s.phone.replace(/[^+\d]/g,'') %>"><%= s.phone %></a></li><li><a href="#contact"><%= s.location_short %></a></li>
      </ul></div>
      <div class="foot"><h4>Follow</h4>
        <div class="social" aria-label="Social media">
          <% socials.forEach(x => { %><a href="<%= x.url %>" target="_blank" rel="noopener" aria-label="<%= x.key %>"><svg><use href="#i-<%= x.key %>"/></svg></a><% }) %>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© <%= year %> <%= s.site_name %>. All images are copyrighted and may not be used without permission.</span>
      <span>Design by <b><%= s.brand_name.toUpperCase() %></b></span>
    </div>
  </div>
</footer>

<!-- ================= LIGHTBOX ================= -->
<div class="lb" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" aria-hidden="true">
  <button class="lb-btn lb-close" id="lbClose" aria-label="Close viewer"><svg><use href="#i-close"/></svg></button>
  <button class="lb-btn lb-prev" id="lbPrev" aria-label="Previous image"><svg><use href="#i-prev"/></svg></button>
  <button class="lb-btn lb-next" id="lbNext" aria-label="Next image"><svg><use href="#i-next"/></svg></button>
  <figure><img id="lbImg" src="" alt=""><figcaption><span><b id="lbTitle"></b> <span id="lbCat"></span></span><span id="lbCount"></span></figcaption></figure>
</div>

<script>
  window.GALLERY = <%- JSON.stringify(gallery.map(g => ({ id: g.id, cat: g.category, title: g.title, alt: g.alt, full: g.src_full, thumb: g.src_thumb }))) %>;
  window.CAT_LABEL = <%- JSON.stringify(catLabel) %>;
</script>
<script src="/js/site.js" defer></script>
</body>
</html>


