<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= project.title %> — <%= s.site_name %></title>
<meta name="description" content="<%= project.description ? project.description.slice(0, 200) : s.seo_description %>">
<link rel="canonical" href="<%= siteUrl %>/projects/<%= project.slug %>">
<meta name="theme-color" content="#0b0d0e">

<meta property="og:type" content="article">
<meta property="og:site_name" content="<%= s.site_name %>">
<meta property="og:title" content="<%= project.title %> — <%= s.site_name %>">
<meta property="og:description" content="<%= project.description ? project.description.slice(0, 200) : s.seo_description %>">
<% if (project.cover_image) { %><meta property="og:image" content="<%= project.cover_image.startsWith('http') ? project.cover_image : siteUrl + project.cover_image %>"><% } %>
<meta property="og:url" content="<%= siteUrl %>/projects/<%= project.slug %>">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230b0d0e'/%3E%3Ctext x='50%25' y='57%25' dominant-baseline='middle' text-anchor='middle' font-family='Arial,sans-serif' font-weight='700' font-size='38' fill='%231fd1c1'%3E<%= s.brand_name.charAt(0).toUpperCase() %>%3C/text%3E%3C/svg%3E">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
</head>

<body>
<a class="skip" href="#main">Skip to content</a>
<div class="curtain" id="curtain" aria-hidden="true"><strong><%= s.brand_name %></strong></div>

<%- include('_sprite') %>

<!-- ================= NAVIGATION ================= -->
<header class="nav" id="nav">
  <div class="container">
    <a class="brand" href="/" aria-label="<%= s.site_name %> — home"><strong><%= s.brand_name %></strong><small><%= s.brand_tagline %></small></a>
    <button class="burger" id="burger" aria-expanded="false" aria-controls="navLinks" aria-label="Open menu"><span></span><span></span><span></span></button>
    <nav class="nav-links" id="navLinks" aria-label="Primary">
      <a href="/#hero">Home</a>
      <a href="/#about">About</a>
      <a href="/#portfolio" class="active">Portfolio</a>
      <a href="/#services">Services</a>
      <a href="/#contact">Contact</a>
      <a href="/#contact" class="btn btn-primary">Book a session</a>
    </nav>
  </div>
</header>

<main id="main">
<section id="project" aria-labelledby="project-title" style="padding-top:calc(var(--nav-h) + 60px)">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow"><a href="/#portfolio" class="btn-link" style="display:inline-flex;font-size:.72rem"><svg style="transform:rotate(180deg)"><use href="#i-arrow"/></svg> Back to portfolio</a></p>
        <h1 class="display" id="project-title" style="margin-top:20px"><%= project.title %></h1>
      </div>
      <% if (project.description) { %><p class="lead"><%= project.description %></p><% } %>
    </div>

    <% if (project.category_label || project.location || project.date) { %>
    <div class="project-meta reveal" style="--d:.05s">
      <% if (project.category_label) { %><span><svg><use href="#i-frame"/></svg><%= project.category_label %></span><% } %>
      <% if (project.location) { %><span><svg><use href="#i-pin"/></svg><%= project.location %></span><% } %>
      <% if (project.date) { %><span><svg><use href="#i-calendar"/></svg><%= new Date(project.date + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></span><% } %>
    </div>
    <% } %>

    <% if (images.length) { %>
    <div class="masonry" id="gallery" aria-live="polite" style="margin-top:56px">
      <% images.forEach((img, i) => { %>
      <button class="tile" type="button" data-id="<%= img.id %>" style="animation-delay:<%= Math.min(i,12)*40 %>ms" aria-label="Open image <%= i + 1 %> of <%= images.length %> in full-screen viewer">
        <img src="<%= img.src_thumb %>" width="<%= img.width %>" height="<%= img.height %>" loading="lazy" decoding="async" alt="<%= img.alt || project.title %>">
        <% if (img.caption) { %><div class="tile-cap"><%= img.caption %></div><% } %>
      </button>
      <% }) %>
    </div>
    <% } else { %>
    <p class="lead" style="margin-top:56px;color:var(--dim)">No photos have been added to this project yet.</p>
    <% } %>
  </div>
</section>
</main>

<!-- ================= FOOTER ================= -->
<footer class="footer">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="/"><strong><%= s.brand_name %></strong><small><%= s.brand_tagline %></small></a>
        <p><%= s.footer_blurb %></p>
      </div>
      <div class="foot"><h4>Navigate</h4><ul>
        <li><a href="/#hero">Home</a></li><li><a href="/#about">About</a></li><li><a href="/#portfolio">Portfolio</a></li><li><a href="/#services">Services</a></li><li><a href="/#contact">Contact</a></li>
      </ul></div>
      <div class="foot"><h4>Contact</h4><ul>
        <li><a href="mailto:<%= s.email %>"><%= s.email %></a></li><li><a href="tel:<%= s.phone.replace(/[^+\d]/g,'') %>"><%= s.phone %></a></li><li><a href="/#contact"><%= s.location_short %></a></li>
      </ul></div>
      <div class="foot"><h4>Follow</h4>
        <div class="social" aria-label="Social media">
          <% socials.forEach(x => { %><a href="<%= x.url %>" target="_blank" rel="noopener" aria-label="<%= x.key %>"><svg><use href="#i-<%= x.key %>"/></svg></a><% }) %>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© <%= year %> <%= s.site_name %>. All images are copyrighted and may not be used without permission.</span>
      <span>Design by <b><%= s.brand_name.toUpperCase() %></b></span>
    </div>
  </div>
</footer>

<!-- ================= LIGHTBOX ================= -->
<div class="lb" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" aria-hidden="true">
  <button class="lb-btn lb-close" id="lbClose" aria-label="Close viewer"><svg><use href="#i-close"/></svg></button>
  <button class="lb-btn lb-prev" id="lbPrev" aria-label="Previous image"><svg><use href="#i-prev"/></svg></button>
  <button class="lb-btn lb-next" id="lbNext" aria-label="Next image"><svg><use href="#i-next"/></svg></button>
  <figure><img id="lbImg" src="" alt=""><figcaption><span><b id="lbTitle"></b> <span id="lbCat"></span></span><span id="lbCount"></span></figcaption></figure>
</div>

<script>
  window.LIGHTBOX_ITEMS = <%- JSON.stringify(images.map(img => ({ id: img.id, title: img.caption || project.title, alt: img.alt || project.title, full: img.src_full, thumb: img.src_thumb }))) %>;
</script>
<script src="/js/site.js" defer></script>
</body>
</html>
