# ---- Server ----
PORT=3000
NODE_ENV=development
# Public URL of the site (used for canonical / Open Graph tags)
SITE_URL=http://localhost:3000

# ---- Security ----
# Long random string used to sign the admin session cookie. CHANGE THIS.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Admin login (used only the FIRST time the database is created) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ---- Storage ----
# Where the SQLite database lives
DATA_DIR=./data
# Where uploaded photos are written (must be served publicly)
UPLOAD_DIR=./public/uploads

# ---- Email notifications (optional — leave blank to just log to console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Adeyemi Visuals <no-reply@adeyemivisuals.com>"
# Where new enquiry alerts are sent
NOTIFY_EMAIL=hello@adeyemivisuals.com
